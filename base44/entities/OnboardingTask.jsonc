{
  "name": "OnboardingTask",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "label_en": {
      "type": "string"
    },
    "label_ar": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending"
    },
    "completed_at": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "code"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.current_business_id}}"
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}