{
  "name": "TemplateConfig",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "template_name": {
      "type": "string"
    },
    "vertical": {
      "type": "string"
    },
    "enabled_modules_json": {
      "type": "string"
    },
    "brand_settings_json": {
      "type": "string"
    },
    "public_page_settings_json": {
      "type": "string"
    }
  },
  "required": [
    "business_id"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.current_business_id}}"
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}