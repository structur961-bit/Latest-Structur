{
  "name": "ProductService",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to Category entity"
    },
    "type": {
      "type": "string",
      "enum": [
        "product",
        "service",
        "menu_item",
        "class",
        "programme",
        "package"
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Legacy text category (kept for backward compat)"
    },
    "sku": {
      "type": "string"
    },
    "barcode_optional": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "cost_price_private": {
      "type": "number"
    },
    "duration_minutes": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "gallery_urls": {
      "type": "string",
      "description": "JSON array of image URLs"
    },
    "variants_json": {
      "type": "string",
      "description": "JSON array of variant objects"
    },
    "modifiers_json": {
      "type": "string",
      "description": "JSON array of modifier objects"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "business_id",
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.current_business_id}}"
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}