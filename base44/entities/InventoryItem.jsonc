{
  "name": "InventoryItem",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "product_service_id": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "variant_key": {
      "type": "string"
    },
    "qty_on_hand": {
      "type": "number",
      "default": 0
    },
    "reorder_level": {
      "type": "number",
      "default": 5
    },
    "supplier_name": {
      "type": "string"
    },
    "supplier_contact": {
      "type": "string"
    },
    "last_restocked_at": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "product_service_id"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.current_business_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_owner"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}