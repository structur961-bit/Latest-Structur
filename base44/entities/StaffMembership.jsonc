{
  "name": "StaffMembership",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "business_owner",
        "manager",
        "staff",
        "customer"
      ],
      "default": "staff"
    },
    "location_ids": {
      "type": "string",
      "description": "JSON array of location IDs"
    },
    "permissions_json": {
      "type": "string",
      "description": "JSON object of granular permissions"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "invited_at": {
      "type": "string"
    },
    "joined_at": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "user_id",
    "role"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.current_business_id}}"
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}