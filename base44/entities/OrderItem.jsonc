{
  "name": "OrderItem",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "product_service_id": {
      "type": "string"
    },
    "name_snapshot": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_price": {
      "type": "number"
    },
    "modifiers_json": {
      "type": "string"
    },
    "variant_json": {
      "type": "string"
    },
    "line_total": {
      "type": "number"
    }
  },
  "required": [
    "business_id",
    "order_id",
    "name_snapshot"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.current_business_id}}"
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}