{
  "name": "Customer",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "birthday": {
      "type": "string",
      "format": "date"
    },
    "gender_optional": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other",
        "prefer_not_to_say"
      ]
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags"
    },
    "notes": {
      "type": "string"
    },
    "marketing_opt_in_email": {
      "type": "boolean",
      "default": false
    },
    "marketing_opt_in_whatsapp": {
      "type": "boolean",
      "default": false
    },
    "loyalty_points": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "last_visit_at": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "full_name"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.current_business_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "business_owner"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}