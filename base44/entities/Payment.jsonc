{
  "name": "Payment",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "registration_id": {
      "type": "string"
    },
    "subscription_id": {
      "type": "string"
    },
    "gateway": {
      "type": "string"
    },
    "provider_reference": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string"
    },
    "paid_at": {
      "type": "string"
    },
    "metadata_json": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}