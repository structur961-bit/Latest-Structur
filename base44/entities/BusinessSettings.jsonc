{
  "name": "BusinessSettings",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "reservation_rules_json": {
      "type": "string"
    },
    "booking_rules_json": {
      "type": "string"
    },
    "loyalty_rules_json": {
      "type": "string"
    },
    "notification_rules_json": {
      "type": "string"
    },
    "payment_rules_json": {
      "type": "string"
    },
    "language_settings_json": {
      "type": "string"
    },
    "tax_settings_json": {
      "type": "string"
    }
  },
  "required": [
    "business_id"
  ],
  "rls": {
    "create": {
      "data.business_id": "{{user.data.current_business_id}}"
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}