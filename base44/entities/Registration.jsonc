{
  "name": "Registration",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "programme_name": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "participant_name": {
      "type": "string"
    },
    "participant_age": {
      "type": "number"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid"
      ],
      "default": "unpaid"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "participant_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.business_id": "{{user.data.current_business_id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}